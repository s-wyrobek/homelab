# Skopiuj ten plik do .env i wypełnij PRAWDZIWYMI wartościami DOPIERO PO
# zrotowaniu każdego z poniższych credentiali (stare wersje uznajemy za spalone).
#
# .env NIGDY nie trafia do gita - już pokryte przez .gitignore.

HOMEPAGE_VAR_PROXMOX_TOKEN=wstaw-tu-nowy-token-po-rotacji
HOMEPAGE_VAR_ADGUARD_PASSWORD=wstaw-tu-nowe-haslo-po-rotacji
HOMEPAGE_VAR_NEXTCLOUD_PASSWORD=wstaw-tu-nowe-haslo-po-rotacji
HOMEPAGE_VAR_GRAFANA_PASSWORD=wstaw-tu-nowe-haslo-po-rotacji

# Hosty, z których Homepage przyjmuje żądania (Host header). Każda nazwa
# używana w przeglądarce musi tu być, inaczej "Host validation failed".
HOMEPAGE_ALLOWED_HOSTS=dash.home,localhost:3000,192.168.1.108:3000
